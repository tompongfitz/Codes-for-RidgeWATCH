from gpiozero import DigitalInputDevice, OutputDevice
import time
import board
import busio
import digitalio
import adafruit_rfm9x
import cv2  
from ultralytics import YOLO
import threading # Added to run the light sensor independently

# --- Configuration Variables ---
CONFIDENCE_THRESHOLD = 0.45           # Relaxed to prevent false negatives
PROCESS_EVERY_N_FRAMES = 3            # FIXED: Process AI every 3rd frame to prevent lag
REQUIRED_CONSECUTIVE_DETECTIONS = 2   # Must detect accident 2 times in a row
LORA_COOLDOWN_SECONDS = 15  

# --- Pin Definitions ---
LDR_PIN = 5
RELAY_PIN = 27

# --- Initialize GPIO Devices ---
ldr = DigitalInputDevice(LDR_PIN)
relay = OutputDevice(RELAY_PIN, active_high=True, initial_value=False)

# --- Initialize LoRa (SX1278) ---
CS = digitalio.DigitalInOut(board.CE1)
RESET = digitalio.DigitalInOut(board.D25)
spi = busio.SPI(board.SCK, MOSI=board.MOSI, MISO=board.MISO)
RADIO_FREQ_MHZ = 433.0

try:
    rfm9x = adafruit_rfm9x.RFM9x(spi, CS, RESET, RADIO_FREQ_MHZ)
    rfm9x.tx_power = 23
    print("LoRa SX1278 initialized.")
except RuntimeError as error:
    print("LoRa initialization failed: ", error)
    rfm9x = None
    
# --- Camera Setup ---
print("Waiting 15 seconds for USB power and hardware to stabilize on boot...")
time.sleep(15) # Restored the 15-second delay to guarantee autostart works

cap = cv2.VideoCapture(0)
# FIXED: Lowered resolution back to VGA to prevent the Raspberry Pi from freezing
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640) 
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

# --- Load the AI Model ---
print("Loading AI Model. This may take a moment...")
model = YOLO("/home/rpi4stem/.venv/best_int8.tflite")
print("AI Model loaded.")

# --- Global Flag for Clean Exit ---
running = True

# --- Dedicated Lighting Thread ---
def lighting_control():
    """Runs in the background, constantly checking the LDR completely independent of the AI."""
    while running:
        if ldr.value == 0: 
            if not relay.is_active: relay.on()
        else:
            if relay.is_active: relay.off()
        time.sleep(0.1) # Small 100ms delay to keep this thread from maxing out the CPU

def detect_accident(frame):
    results = model.predict(source=frame, conf=CONFIDENCE_THRESHOLD, verbose=False)
    
    # ALWAYS draw the bounding boxes, regardless of what it finds
    annotated_frame = results[0].plot()
    found_accident = False
    
    for result in results:
        for box in result.boxes:
            class_id = int(box.cls)
            class_name = model.names[class_id]
            confidence = float(box.conf)
            
            print(f"[AI RAW DETECTION]: '{class_name}' at {confidence*100:.1f}%")
            
            if any(word in class_name.lower() for word in ["car-accident"]):
                found_accident = True
                
    return found_accident, annotated_frame

def main():
    global running
    print("System running... Press Ctrl+C in terminal to exit.")
    
    # 1. Start the Independent Light Sensor Thread
    light_thread = threading.Thread(target=lighting_control)
    light_thread.start()
    print("Independent lighting control activated.")
    
    last_alert_time = 0  
    frame_count = 0
    consecutive_accident_count = 0
    display_frame = None 

    try:
        while True:
            # 2. Process Camera with AI (LDR is no longer blocking this loop!)
            ret, frame = cap.read()
            if ret:
                frame_count += 1
                
                if frame_count % PROCESS_EVERY_N_FRAMES == 0:
                    is_accident, display_frame = detect_accident(frame)
                    current_time = time.time()
                    
                    if is_accident:
                        consecutive_accident_count += 1
                        print(f"[VERIFYING]: Potential accident ({consecutive_accident_count}/{REQUIRED_CONSECUTIVE_DETECTIONS})")
                    else:
                        consecutive_accident_count = 0  
                    
                    if (consecutive_accident_count >= REQUIRED_CONSECUTIVE_DETECTIONS) and \
                       (current_time - last_alert_time > LORA_COOLDOWN_SECONDS):
                        
                        print("\n[CONFIRMED ALERT] Sustained accident detected!")
                        if rfm9x:
                            rfm9x.send(bytes("Accident Detected", "utf-8"))
                            print("Alert sent via LoRa.")
                        last_alert_time = current_time
                        consecutive_accident_count = 0 
                        
                elif display_frame is None:
                    # Failsafe: if the loop starts before AI runs, show raw frame
                    display_frame = frame
                    
                # 3. Show the annotated AI view on your screen
                cv2.imshow("Live AI Feed", display_frame)
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

    except KeyboardInterrupt:
        print("\nExiting program...")
    finally:
        # Safely shut down both the hardware and the background thread
        running = False 
        light_thread.join() 
        relay.off()
        cap.release()
        cv2.destroyAllWindows() 
        print("Hardware safely shut down.")

if __name__ == "__main__":
    main()
